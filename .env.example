# Singh Automation Environment Variables
# Copy this file to .env and fill in your values
# Last updated: 2026-01-04

# ===========================================
# REQUIRED API KEYS
# ===========================================

# SAM.gov API Key - Get from https://api.sam.gov/
# Registration: Create account at SAM.gov, go to Profile > API Keys
# Type: Public API (free, instant approval for public data)
# CRITICAL: Never commit actual API keys to version control
SAM_API_KEY=your_sam_api_key_here

# Anthropic Claude API Key - For proposal generation
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# SAM.GOV API CONFIGURATION
# ===========================================

# SAM.gov API base URL (production)
SAM_API_URL=https://api.sam.gov/opportunities/v2/search

# Singh Automation NAICS codes for opportunity scanning
# Comma-separated list of NAICS codes relevant to our business
SINGH_NAICS_CODES=333249,541330,541512,541715,238210,333922

# Keywords for opportunity matching
SINGH_KEYWORDS=robotics,welding,automation,PLC,SCADA,vision systems,FANUC

# ===========================================
# DEADLINE MONITORING
# ===========================================

# Days before deadline to flag as urgent (default: 7)
DEADLINE_URGENT_DAYS=7

# Days before deadline to flag as warning (default: 14)
DEADLINE_WARNING_DAYS=14

# Auto-archive opportunities after deadline (true/false)
AUTO_ARCHIVE_EXPIRED=true

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# WinScope Backend URL (defaults to localhost for development)
WINSCOPE_API_URL=http://localhost:8000

# Allowed CORS origins (comma-separated)
# Example: https://singh-automation.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# RATE LIMITING
# ===========================================

# Maximum requests per minute per IP
RATE_LIMIT_MAX=60

# Rate limit window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# TIMEOUTS (in milliseconds)
# ===========================================

# External API fetch timeout
FETCH_TIMEOUT_MS=8000

# Claude API timeout
CLAUDE_TIMEOUT_MS=90000

# Job polling timeout
JOB_TIMEOUT_MS=300000

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable detailed logging
DEBUG_MODE=false

# Enable mock data for testing (bypasses live API calls)
USE_MOCK_DATA=false

# Enable demo mode warning banner
SHOW_DEMO_WARNING=true
