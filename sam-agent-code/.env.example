# Sam Agent 2.0 Environment Variables

# ===================
# Required API Keys
# ===================

# SAM.gov API Key (free at sam.gov/content/entity-registration)
SAM_API_KEY=your_sam_api_key

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key

# ===================
# Database (Supabase)
# ===================

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key
SUPABASE_KEY=your_supabase_anon_key

# ===================
# API Configuration
# ===================

# API server host
API_HOST=0.0.0.0

# API server port
API_PORT=8080

# ===================
# Scheduling
# ===================

# Hour to run daily scrape (24h format, UTC)
DAILY_SCRAPE_HOUR=6

# Hour to generate daily briefing (24h format, UTC)
BRIEFING_HOUR=7

# ===================
# Optional: LinkedIn
# ===================

# LINKEDIN_EMAIL=your_email
# LINKEDIN_PASSWORD=your_password

# ===================
# Optional: Proxy
# ===================

# PROXY_URL=http://proxy:port
