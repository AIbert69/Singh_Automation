# Sam Agent 2.0 Environment Variables

# ===========================================
# Required - Core APIs
# ===========================================

# SAM.gov API Key (free registration at https://api.sam.gov)
SAM_API_KEY=your_sam_api_key_here

# Anthropic API Key for Claude
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ===========================================
# Required - Database
# ===========================================

# Supabase connection (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Or use direct PostgreSQL connection
# DATABASE_URL=postgresql://user:password@host:5432/database

# ===========================================
# Optional - Proxy Configuration
# ===========================================

# Residential proxy for web scraping (recommended)
# Services: Bright Data, Oxylabs, Smartproxy
PROXY_URL=http://user:pass@proxy.example.com:port

# ===========================================
# Optional - Notifications
# ===========================================

# Push notification service (for mobile app)
EXPO_PUSH_TOKEN=

# ===========================================
# Optional - Additional Scrapers
# ===========================================

# LinkedIn (NOT recommended due to ToS - use at own risk)
# LINKEDIN_EMAIL=your_email
# LINKEDIN_PASSWORD=your_password

# ===========================================
# Development Settings
# ===========================================

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug logging
DEBUG=true

# API server port
PORT=8080

# ===========================================
# Mobile App Configuration
# ===========================================

# Backend API URL for mobile app
EXPO_PUBLIC_API_URL=http://localhost:8080

# ===========================================
# Security
# ===========================================

# Secret key for session management (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
